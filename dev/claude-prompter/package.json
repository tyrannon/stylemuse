{
  "name": "claude-prompter",
  "version": "1.0.0",
  "description": "CLI tool for generating and sending prompts to GPT-4o",
  "main": "dist/cli.js",
  "bin": {
    "claude-prompter": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli.ts",
    "start": "node dist/cli.js",
    "clean": "rm -rf dist",
    "prepare": "npm run build"
  },
  "keywords": [
    "cli",
    "openai",
    "gpt-4o",
